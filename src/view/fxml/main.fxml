<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="720.0" prefWidth="1280.0" stylesheets="@../css/main.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.MainController">
   <children>
      <HBox AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
         <children>

            <!-- Sidebar -->
            <fx:include source="/view/fxml/sidebar_etudiant.fxml" fx:id="sidebar" />

            <!-- Contenu principal -->
            <VBox HBox.hgrow="ALWAYS">
               <children>

                  <!-- Topbar -->
                  <fx:include source="/view/fxml/topbar.fxml" fx:id="topbar" />

                  <!-- Zone de contenu central -->
                  <AnchorPane fx:id="contenuPrincipal" VBox.vgrow="ALWAYS" style="-fx-background-color: #f8fafc;" />

               </children>
            </VBox>

         </children>
      </HBox>
   </children>
</AnchorPane>