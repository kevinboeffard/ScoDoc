<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.SaisirNotesEnseignantController"
            style="-fx-background-color: #f8fafc;">
   <children>
      <VBox spacing="20.0" AnchorPane.topAnchor="30.0" AnchorPane.leftAnchor="30.0"
            AnchorPane.rightAnchor="30.0" AnchorPane.bottomAnchor="30.0">
         <children>

            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <VBox spacing="4.0">
                     <children>
                        <Label text="Saisir des notes" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />
                        <Label text="Vue globale par promotion et par module" style="-fx-font-size: 13px; -fx-text-fill: #64748b;" />
                     </children>
                  </VBox>
                  <Region HBox.hgrow="ALWAYS" />
                  <Button text="+ Nouvelle évaluation" onAction="#handleAfficherFormulaire"
                          style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 10px 18px; -fx-background-radius: 8px; -fx-cursor: hand;" />
               </children>
            </HBox>

            <VBox fx:id="formNouvelleEval" spacing="14.0" visible="false" managed="false"
                  style="-fx-background-color: white; -fx-background-radius: 12px; -fx-border-color: #e2e8f0; -fx-border-radius: 12px; -fx-padding: 18px;">
               <children>
                  <Label text="Nouvelle évaluation" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />

                  <HBox spacing="16.0">
                     <children>
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label text="MODULE / RESSOURCE" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #94a3b8;" />
                              <ComboBox fx:id="comboModuleNouvelleEval" maxWidth="1.7976931348623157E308" />
                           </children>
                        </VBox>
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label text="NOM DE L'ÉVALUATION" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #94a3b8;" />
                              <TextField fx:id="champNomEval" promptText="ex : DS 2 — Récursivité et arbres" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>

                  <VBox spacing="4.0">
                     <children>
                        <Label text="TYPE D'ÉVALUATION" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #94a3b8;" />
                        <HBox spacing="8.0">
                           <children>
                              <Button text="DS — Devoir surveillé" onAction="#handleTypeDS"
                                      style="-fx-background-color: white; -fx-text-fill: #64748b; -fx-font-size: 11px; -fx-padding: 6px 12px; -fx-background-radius: 6px; -fx-border-color: #e2e8f0; -fx-border-radius: 6px; -fx-cursor: hand;" />
                              <Button text="TP noté" onAction="#handleTypeTP"
                                      style="-fx-background-color: white; -fx-text-fill: #64748b; -fx-font-size: 11px; -fx-padding: 6px 12px; -fx-background-radius: 6px; -fx-border-color: #e2e8f0; -fx-border-radius: 6px; -fx-cursor: hand;" />
                              <Button text="CC — Contrôle continu" onAction="#handleTypeCC"
                                      style="-fx-background-color: white; -fx-text-fill: #64748b; -fx-font-size: 11px; -fx-padding: 6px 12px; -fx-background-radius: 6px; -fx-border-color: #e2e8f0; -fx-border-radius: 6px; -fx-cursor: hand;" />
                              <Button text="Projet" onAction="#handleTypeProjet"
                                      style="-fx-background-color: white; -fx-text-fill: #64748b; -fx-font-size: 11px; -fx-padding: 6px 12px; -fx-background-radius: 6px; -fx-border-color: #e2e8f0; -fx-border-radius: 6px; -fx-cursor: hand;" />
                              <Button text="SAÉ" onAction="#handleTypeSAE"
                                      style="-fx-background-color: white; -fx-text-fill: #64748b; -fx-font-size: 11px; -fx-padding: 6px 12px; -fx-background-radius: 6px; -fx-border-color: #e2e8f0; -fx-border-radius: 6px; -fx-cursor: hand;" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>

                  <VBox spacing="4.0">
                     <children>
                        <Label text="COEFFICIENT" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #94a3b8;" />
                        <TextField fx:id="champCoeffEval" promptText="1" prefWidth="120.0" />
                     </children>
                  </VBox>

                  <HBox spacing="10.0" alignment="CENTER_LEFT">
                     <children>
                        <Label fx:id="lblMessage" text="" style="-fx-font-size: 12px; -fx-font-weight: bold;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button text="Annuler" onAction="#handleAnnulerFormulaire"
                                style="-fx-background-color: white; -fx-text-fill: #64748b; -fx-font-size: 12px; -fx-padding: 8px 16px; -fx-background-radius: 8px; -fx-border-color: #e2e8f0; -fx-border-radius: 8px; -fx-cursor: hand;" />
                        <Button text="Créer l'évaluation" onAction="#handleCreerEvaluation"
                                style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 8px 18px; -fx-background-radius: 8px; -fx-cursor: hand;" />
                     </children>
                  </HBox>
               </children>
            </VBox>

            <HBox fx:id="conteneurStats" spacing="16.0" />

            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
               <content>
                  <VBox fx:id="conteneurPromotions" spacing="16.0" />
               </content>
            </ScrollPane>

         </children>
      </VBox>
   </children>
</AnchorPane>