<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.EmploiDuTempsEtudiantController"
            style="-fx-background-color: #f8fafc;">
   <children>
      <VBox spacing="20.0" AnchorPane.topAnchor="30.0" AnchorPane.leftAnchor="30.0"
            AnchorPane.rightAnchor="30.0" AnchorPane.bottomAnchor="30.0">
         <children>

            <VBox spacing="4.0">
               <children>
                  <Label text="Emploi du temps" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />
                  <Label text="Vue de votre planning, jour par jour" style="-fx-font-size: 13px; -fx-text-fill: #64748b;" />
               </children>
            </VBox>

            <HBox spacing="10.0" alignment="CENTER_LEFT">
               <children>
                  <Button text="◀" onAction="#handlePrecedent"
                          style="-fx-background-color: white; -fx-text-fill: #1e293b; -fx-font-size: 13px; -fx-padding: 6px 14px; -fx-background-radius: 8px; -fx-border-color: #e2e8f0; -fx-border-radius: 8px; -fx-cursor: hand;" />
                  <Button text="▶" onAction="#handleSuivant"
                          style="-fx-background-color: white; -fx-text-fill: #1e293b; -fx-font-size: 13px; -fx-padding: 6px 14px; -fx-background-radius: 8px; -fx-border-color: #e2e8f0; -fx-border-radius: 8px; -fx-cursor: hand;" />
                  <Label fx:id="lblDate" text="--" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1e293b; -fx-padding: 0 0 0 10px;" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Button text="Aujourd'hui" onAction="#handleAujourdhui"
                          style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 6px 16px; -fx-background-radius: 8px; -fx-cursor: hand;" />
               </children>
            </HBox>

            <HBox spacing="20.0" VBox.vgrow="ALWAYS">
               <children>

                  <ScrollPane fitToWidth="true" HBox.hgrow="ALWAYS" style="-fx-background-color: transparent;">
                     <content>
                        <VBox fx:id="conteneurSeances" spacing="10.0" />
                     </content>
                  </ScrollPane>

                  <VBox spacing="16.0" prefWidth="280.0" minWidth="280.0">
                     <children>

                        <VBox spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 12px; -fx-border-color: #e2e8f0; -fx-border-radius: 12px; -fx-padding: 16px;">
                           <children>
                              <Label text="Résumé du jour" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />
                              <HBox spacing="10.0">
                                 <children>
                                    <Label text="Séances" style="-fx-font-size: 12px; -fx-text-fill: #64748b;" HBox.hgrow="ALWAYS" />
                                    <Label fx:id="lblNbSeances" text="--" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />
                                 </children>
                              </HBox>
                              <HBox spacing="10.0">
                                 <children>
                                    <Label text="Volume horaire" style="-fx-font-size: 12px; -fx-text-fill: #64748b;" HBox.hgrow="ALWAYS" />
                                    <Label fx:id="lblVolumeHoraire" text="--" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />
                                 </children>
                              </HBox>
                              <HBox spacing="10.0">
                                 <children>
                                    <Label text="Début des cours" style="-fx-font-size: 12px; -fx-text-fill: #64748b;" HBox.hgrow="ALWAYS" />
                                    <Label fx:id="lblDebutCours" text="--" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />
                                 </children>
                              </HBox>
                              <HBox spacing="10.0">
                                 <children>
                                    <Label text="Fin des cours" style="-fx-font-size: 12px; -fx-text-fill: #64748b;" HBox.hgrow="ALWAYS" />
                                    <Label fx:id="lblFinCours" text="--" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />
                                 </children>
                              </HBox>
                           </children>
                        </VBox>

                        <VBox spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 12px; -fx-border-color: #e2e8f0; -fx-border-radius: 12px; -fx-padding: 16px;">
                           <children>
                              <HBox alignment="CENTER_LEFT" spacing="10.0">
                                 <children>
                                    <Button text="◀" onAction="#handleMoisPrecedent"
                                          style="-fx-background-color: #f1f5f9; -fx-text-fill: #1e293b; -fx-font-size: 11px; -fx-padding: 4px 10px; -fx-background-radius: 6px; -fx-cursor: hand;" />
                                    <Label fx:id="lblMoisAnnee" text="--" maxWidth="1.7976931348623157E308"
                                          style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1e293b; -fx-alignment: center;" HBox.hgrow="ALWAYS" />
                                    <Button text="▶" onAction="#handleMoisSuivant"
                                          style="-fx-background-color: #f1f5f9; -fx-text-fill: #1e293b; -fx-font-size: 11px; -fx-padding: 4px 10px; -fx-background-radius: 6px; -fx-cursor: hand;" />
                                 </children>
                              </HBox>
                              <GridPane fx:id="calendrier" hgap="4.0" vgap="6.0" />
                           </children>
                        </VBox>

                     </children>
                  </VBox>

               </children>
            </HBox>

         </children>
      </VBox>
   </children>
</AnchorPane>