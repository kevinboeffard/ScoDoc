<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.AbsencesEnseignantController"
            style="-fx-background-color: #f8fafc;">
   <children>
      <VBox spacing="20.0" AnchorPane.topAnchor="30.0" AnchorPane.leftAnchor="30.0"
            AnchorPane.rightAnchor="30.0" AnchorPane.bottomAnchor="30.0">
         <children>

            <VBox spacing="4.0">
               <children>
                  <Label text="Absences" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />
                  <Label text="Vos séances et l'état de leur feuille d'appel" style="-fx-font-size: 13px; -fx-text-fill: #64748b;" />
               </children>
            </VBox>

            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
               <content>
                  <VBox fx:id="conteneurSeances" spacing="10.0" />
               </content>
            </ScrollPane>

         </children>
      </VBox>
   </children>
</AnchorPane>