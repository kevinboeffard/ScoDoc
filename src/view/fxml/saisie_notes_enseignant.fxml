<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.SaisieNotesEnseignantController"
            style="-fx-background-color: #f8fafc;">
   <children>
      <VBox spacing="20.0" AnchorPane.topAnchor="30.0" AnchorPane.leftAnchor="30.0"
            AnchorPane.rightAnchor="30.0" AnchorPane.bottomAnchor="30.0">
         <children>

            <HBox alignment="CENTER_LEFT" spacing="14.0">
               <children>
                  <Button text="◀ Retour" onAction="#handleRetour"
                          style="-fx-background-color: white; -fx-text-fill: #1e293b; -fx-font-size: 12px; -fx-padding: 6px 14px; -fx-background-radius: 8px; -fx-border-color: #e2e8f0; -fx-border-radius: 8px; -fx-cursor: hand;" />
                  <VBox spacing="2.0">
                     <children>
                        <Label fx:id="lblTitre" text="--" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />
                        <Label fx:id="lblSousTitre" text="--" style="-fx-font-size: 12px; -fx-text-fill: #64748b;" />
                     </children>
                  </VBox>
               </children>
            </HBox>

            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
               <content>
                  <VBox fx:id="conteneurEtudiants" spacing="8.0" />
               </content>
            </ScrollPane>

            <HBox spacing="14.0" alignment="CENTER_LEFT">
               <children>
                  <Label fx:id="lblMessage" text="" style="-fx-font-size: 12px; -fx-font-weight: bold;" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Button text="Enregistrer les notes" onAction="#handleEnregistrer"
                          style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 10px 24px; -fx-background-radius: 8px; -fx-cursor: hand;" />
               </children>
            </HBox>

         </children>
      </VBox>
   </children>
</AnchorPane>