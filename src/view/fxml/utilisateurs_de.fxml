<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.UtilisateursDEController"
            style="-fx-background-color: #f8fafc;">
   <children>
      <VBox spacing="20.0" AnchorPane.topAnchor="30.0" AnchorPane.leftAnchor="30.0"
            AnchorPane.rightAnchor="30.0" AnchorPane.bottomAnchor="30.0">
         <children>

            <VBox spacing="4.0">
               <children>
                  <Label text="Utilisateurs" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />
                  <Label text="Gestion des comptes étudiants, enseignants et directeurs des études" style="-fx-font-size: 13px; -fx-text-fill: #64748b;" />
               </children>
            </VBox>

            <HBox spacing="16.0">
               <children>
                  <VBox spacing="4.0" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 12px; -fx-border-color: #e2e8f0; -fx-border-radius: 12px; -fx-padding: 16px;">
                     <children>
                        <Label fx:id="lblTotal" text="--" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />
                        <Label text="TOTAL UTILISATEURS" style="-fx-font-size: 11px; -fx-text-fill: #94a3b8; -fx-font-weight: bold;" />
                     </children>
                  </VBox>
                  <VBox spacing="4.0" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 12px; -fx-border-color: #e2e8f0; -fx-border-radius: 12px; -fx-padding: 16px;">
                     <children>
                        <Label fx:id="lblNbEtudiants" text="--" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #3b82f6;" />
                        <Label text="ÉTUDIANTS" style="-fx-font-size: 11px; -fx-text-fill: #94a3b8; -fx-font-weight: bold;" />
                     </children>
                  </VBox>
                  <VBox spacing="4.0" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 12px; -fx-border-color: #e2e8f0; -fx-border-radius: 12px; -fx-padding: 16px;">
                     <children>
                        <Label fx:id="lblNbEnseignants" text="--" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #16a34a;" />
                        <Label text="ENSEIGNANTS" style="-fx-font-size: 11px; -fx-text-fill: #94a3b8; -fx-font-weight: bold;" />
                     </children>
                  </VBox>
                  <VBox spacing="4.0" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 12px; -fx-border-color: #e2e8f0; -fx-border-radius: 12px; -fx-padding: 16px;">
                     <children>
                        <Label fx:id="lblNbDirecteurs" text="--" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #9333ea;" />
                        <Label text="DIRECTEURS DES ÉTUDES" style="-fx-font-size: 11px; -fx-text-fill: #94a3b8; -fx-font-weight: bold;" />
                     </children>
                  </VBox>
               </children>
            </HBox>

            <HBox spacing="10.0" alignment="CENTER_LEFT">
               <children>
                  <Button fx:id="btnFiltreTous" text="Tous" onAction="#handleFiltreTous"
                          style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 6px 16px; -fx-background-radius: 8px; -fx-cursor: hand;" />
                  <Button fx:id="btnFiltreEtudiants" text="Étudiants" onAction="#handleFiltreEtudiants"
                          style="-fx-background-color: white; -fx-text-fill: #64748b; -fx-font-size: 12px; -fx-padding: 6px 16px; -fx-background-radius: 8px; -fx-border-color: #e2e8f0; -fx-border-radius: 8px; -fx-cursor: hand;" />
                  <Button fx:id="btnFiltreEnseignants" text="Enseignants" onAction="#handleFiltreEnseignants"
                          style="-fx-background-color: white; -fx-text-fill: #64748b; -fx-font-size: 12px; -fx-padding: 6px 16px; -fx-background-radius: 8px; -fx-border-color: #e2e8f0; -fx-border-radius: 8px; -fx-cursor: hand;" />
                  <Button fx:id="btnFiltreDirecteurs" text="Directeurs des études" onAction="#handleFiltreDirecteurs"
                          style="-fx-background-color: white; -fx-text-fill: #64748b; -fx-font-size: 12px; -fx-padding: 6px 16px; -fx-background-radius: 8px; -fx-border-color: #e2e8f0; -fx-border-radius: 8px; -fx-cursor: hand;" />
                  <Region HBox.hgrow="ALWAYS" />
                  <TextField fx:id="champRecherche" promptText="Rechercher par nom, prénom, email, identifiant..." prefWidth="260.0"
                             style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 8px 12px; -fx-font-size: 12px;" />
                  <Button text="+ Nouvel utilisateur" onAction="#handleAfficherFormulaire"
                          style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 8px 16px; -fx-background-radius: 8px; -fx-cursor: hand;" />
               </children>
            </HBox>

            <VBox fx:id="formNouvelUtilisateur" spacing="14.0" visible="false" managed="false"
                  style="-fx-background-color: white; -fx-background-radius: 12px; -fx-border-color: #e2e8f0; -fx-border-radius: 12px; -fx-padding: 18px;">
               <children>
                  <Label text="Nouvel utilisateur" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />

                  <VBox spacing="4.0">
                     <children>
                        <Label text="TYPE D'UTILISATEUR" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #94a3b8;" />
                        <ComboBox fx:id="comboTypeUtilisateur" prefWidth="260.0" />
                     </children>
                  </VBox>

                  <HBox spacing="16.0">
                     <children>
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label text="NOM" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #94a3b8;" />
                              <TextField fx:id="champNom" promptText="Nom" />
                           </children>
                        </VBox>
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label text="PRÉNOM" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #94a3b8;" />
                              <TextField fx:id="champPrenom" promptText="Prénom" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>

                  <HBox spacing="16.0">
                     <children>
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label text="EMAIL" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #94a3b8;" />
                              <TextField fx:id="champEmail" promptText="prenom.nom@iut.fr" />
                           </children>
                        </VBox>
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label text="MOT DE PASSE" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #94a3b8;" />
                              <PasswordField fx:id="champMdp" promptText="Mot de passe" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>

                  <HBox fx:id="blocEtudiant" spacing="16.0" visible="true" managed="true">
                     <children>
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label text="NUMÉRO ÉTUDIANT" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #94a3b8;" />
                              <TextField fx:id="champNumEtudiant" promptText="ex : E042" />
                           </children>
                        </VBox>
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label text="GROUPE" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #94a3b8;" />
                              <ComboBox fx:id="comboGroupeNouvelUtilisateur" maxWidth="1.7976931348623157E308" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>

                  <HBox fx:id="blocEnseignant" spacing="16.0" visible="false" managed="false">
                     <children>
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label text="IDENTIFIANT" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #94a3b8;" />
                              <TextField fx:id="champIdentifiant" promptText="ex : jdupont" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>

                  <HBox spacing="10.0" alignment="CENTER_LEFT">
                     <children>
                        <Label fx:id="lblMessage" text="" style="-fx-font-size: 12px; -fx-font-weight: bold;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button text="Annuler" onAction="#handleAnnulerFormulaire"
                                style="-fx-background-color: white; -fx-text-fill: #64748b; -fx-font-size: 12px; -fx-padding: 8px 16px; -fx-background-radius: 8px; -fx-border-color: #e2e8f0; -fx-border-radius: 8px; -fx-cursor: hand;" />
                        <Button text="Créer l'utilisateur" onAction="#handleCreerUtilisateur"
                                style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 8px 18px; -fx-background-radius: 8px; -fx-cursor: hand;" />
                     </children>
                  </HBox>
               </children>
            </VBox>

            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
               <content>
                  <TableView fx:id="table">
                     <columns>
                        <TableColumn fx:id="colIdentifiant" text="Identifiant" prefWidth="100.0" />
                        <TableColumn fx:id="colNom" text="Nom" prefWidth="120.0" />
                        <TableColumn fx:id="colPrenom" text="Prénom" prefWidth="120.0" />
                        <TableColumn fx:id="colEmail" text="Email" prefWidth="200.0" />
                        <TableColumn fx:id="colType" text="Type" prefWidth="160.0" />
                        <TableColumn fx:id="colDetail" text="Détail" prefWidth="160.0" />
                        <TableColumn fx:id="colAction" text="Action" prefWidth="100.0" />
                     </columns>
                  </TableView>
               </content>
            </ScrollPane>

         </children>
      </VBox>
   </children>
</AnchorPane>