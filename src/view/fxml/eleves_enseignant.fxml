<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.ElevesEnseignantController"
            style="-fx-background-color: #f8fafc;">
   <children>
      <VBox spacing="20.0" AnchorPane.topAnchor="30.0" AnchorPane.leftAnchor="30.0"
            AnchorPane.rightAnchor="30.0" AnchorPane.bottomAnchor="30.0">
         <children>

            <VBox spacing="4.0">
               <children>
                  <Label text="Élèves" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />
                  <Label text="Liste de tous les étudiants, par promotion et par groupe" style="-fx-font-size: 13px; -fx-text-fill: #64748b;" />
               </children>
            </VBox>

            <TextField fx:id="champRecherche" promptText="Rechercher un élève par nom, prénom ou numéro étudiant..."
                       style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 10px 14px; -fx-font-size: 13px;" />

            <HBox fx:id="conteneurStats" spacing="16.0" />

            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
               <content>
                  <VBox fx:id="conteneurListe" spacing="16.0" />
               </content>
            </ScrollPane>

         </children>
      </VBox>
   </children>
</AnchorPane>