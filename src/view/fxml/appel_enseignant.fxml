<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.AppelEnseignantController"
            style="-fx-background-color: #f8fafc;">
   <children>
      <VBox spacing="20.0" AnchorPane.topAnchor="30.0" AnchorPane.leftAnchor="30.0"
            AnchorPane.rightAnchor="30.0" AnchorPane.bottomAnchor="30.0">
         <children>

            <HBox alignment="CENTER_LEFT" spacing="14.0">
               <children>
                  <Button text="◀ Retour" onAction="#handleRetour"
                          style="-fx-background-color: white; -fx-text-fill: #1e293b; -fx-font-size: 12px; -fx-padding: 6px 14px; -fx-background-radius: 8px; -fx-border-color: #e2e8f0; -fx-border-radius: 8px; -fx-cursor: hand;" />
                  <VBox spacing="2.0">
                     <children>
                        <Label fx:id="lblTitre" text="--" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />
                        <Label fx:id="lblSousTitre" text="--" style="-fx-font-size: 12px; -fx-text-fill: #64748b;" />
                     </children>
                  </VBox>
               </children>
            </HBox>

            <HBox spacing="16.0">
               <children>
                  <VBox spacing="4.0" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 12px; -fx-border-color: #e2e8f0; -fx-border-radius: 12px; -fx-padding: 16px;">
                     <children>
                        <Label fx:id="lblPresents" text="--" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #16a34a;" />
                        <Label text="PRÉSENTS" style="-fx-font-size: 11px; -fx-text-fill: #94a3b8; -fx-font-weight: bold;" />
                     </children>
                  </VBox>
                  <VBox spacing="4.0" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 12px; -fx-border-color: #e2e8f0; -fx-border-radius: 12px; -fx-padding: 16px;">
                     <children>
                        <Label fx:id="lblAbsents" text="--" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #dc2626;" />
                        <Label text="ABSENTS" style="-fx-font-size: 11px; -fx-text-fill: #94a3b8; -fx-font-weight: bold;" />
                     </children>
                  </VBox>
                  <VBox spacing="4.0" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 12px; -fx-border-color: #e2e8f0; -fx-border-radius: 12px; -fx-padding: 16px;">
                     <children>
                        <Label fx:id="lblRetards" text="--" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #ca8a04;" />
                        <Label text="EN RETARD" style="-fx-font-size: 11px; -fx-text-fill: #94a3b8; -fx-font-weight: bold;" />
                     </children>
                  </VBox>
                  <VBox spacing="4.0" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 12px; -fx-border-color: #e2e8f0; -fx-border-radius: 12px; -fx-padding: 16px;">
                     <children>
                        <Label fx:id="lblTotal" text="--" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />
                        <Label text="TOTAL" style="-fx-font-size: 11px; -fx-text-fill: #94a3b8; -fx-font-weight: bold;" />
                     </children>
                  </VBox>
               </children>
            </HBox>

            <HBox spacing="10.0" alignment="CENTER_LEFT">
               <children>
                  <Button fx:id="btnFiltreTous" text="Tous" onAction="#handleFiltreTous"
                          style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 6px 16px; -fx-background-radius: 8px; -fx-cursor: hand;" />
                  <Button fx:id="btnFiltreAbsents" text="Absents" onAction="#handleFiltreAbsents"
                          style="-fx-background-color: white; -fx-text-fill: #64748b; -fx-font-size: 12px; -fx-padding: 6px 16px; -fx-background-radius: 8px; -fx-border-color: #e2e8f0; -fx-border-radius: 8px; -fx-cursor: hand;" />
                  <Button fx:id="btnFiltreRetards" text="En retard" onAction="#handleFiltreRetards"
                          style="-fx-background-color: white; -fx-text-fill: #64748b; -fx-font-size: 12px; -fx-padding: 6px 16px; -fx-background-radius: 8px; -fx-border-color: #e2e8f0; -fx-border-radius: 8px; -fx-cursor: hand;" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Button text="✓ Tous présents" onAction="#handleTousPresents"
                          style="-fx-background-color: #dcfce7; -fx-text-fill: #16a34a; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 6px 16px; -fx-background-radius: 8px; -fx-cursor: hand;" />
               </children>
            </HBox>

            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
               <content>
                  <VBox fx:id="conteneurEtudiants" spacing="8.0" />
               </content>
            </ScrollPane>

            <HBox spacing="14.0" alignment="CENTER_LEFT">
               <children>
                  <Label fx:id="lblMessage" text="" style="-fx-font-size: 12px; -fx-font-weight: bold;" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Button text="Valider la séance" onAction="#handleValider"
                          style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 10px 24px; -fx-background-radius: 8px; -fx-cursor: hand;" />
               </children>
            </HBox>

         </children>
      </VBox>
   </children>
</AnchorPane>